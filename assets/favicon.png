    private Image cristo;

    public CristoSapucaia() {
        byte[] bytes = Base64.getDecoder().decode(CRISTO_BASE64.replaceAll("\\s+", ""));
        cristo = Toolkit.getDefaultToolkit().createImage(bytes);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);

        int w = getWidth();
        int h = getHeight();

        g.setColor(Color.BLACK);
        g.fillRect(0, 0, w, h);

        int size = Math.min(w, h) - 40;
        int x = (w - size) / 2;
        int y = (h - size) / 2;

        g.drawImage(cristo, x, y, size, size, this);
    }

    public static void main(String[] args) throws Exception {
        // Também cria o arquivo PNG automaticamente na mesma pasta.
        byte[] bytes = Base64.getDecoder().decode(CRISTO_BASE64.replaceAll("\\s+", ""));
        try (FileOutputStream out = new FileOutputStream("cristo-sapucaia.png")) {
            out.write(bytes);
        }

        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("SAPUCAIA • Cristo");
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            frame.setSize(700, 700);
            frame.setLocationRelativeTo(null);
            frame.setContentPane(new CristoSapucaia());
            frame.setVisible(true);
        });
    }
}
